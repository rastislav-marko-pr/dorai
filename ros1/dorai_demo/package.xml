<?xml version="1.0"?>
<package format="2">
  <name>dorai_demo</name>
  <version>0.1.0</version>
  <description>
    DORAI demo: ROS 1 side. Camera person detection, UDP bridge to the ROS 2
    audio container, and the behaviour state machine that drives Artaban.
  </description>
  <maintainer email="rastislav.marko@panzarobotics.com">Rastislav Marko</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>nodelet</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>pr_depthai_ros</exec_depend>
</package>
